{
  "name": "@vibe-portal/api",
  "version": "0.3.5",
  "private": true,
  "license": "PolyForm-Small-Business-1.0.0",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=20000",
    "firm-key": "tsx --env-file-if-exists=../../.env src/scripts/firm-key.ts",
    "staff-setup": "tsx --env-file-if-exists=../../.env src/scripts/staff-setup.ts",
    "storage-move": "tsx --env-file-if-exists=../../.env src/scripts/storage-move.ts",
    "snapshot-restore": "tsx --env-file-if-exists=../../.env src/scripts/snapshot-restore.ts",
    "test-email": "tsx --env-file-if-exists=../../.env src/scripts/test-email.ts"
  },
  "vibeAuth": {
    "adapter": "./src/staff/sso-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/lib-storage": "^3.600.0",
    "@kisaesdevlab/vibe-auth": "1.0.23",
    "@noble/ciphers": "^1.0.0",
    "@vibe-portal/db": "workspace:*",
    "@vibe-portal/types": "workspace:*",
    "@vibe/crypto": "workspace:*",
    "argon2": "^0.41.1",
    "cookie": "^0.7.2",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "heic-convert": "^2.1.0",
    "nodemailer": "^7.0.10",
    "pdf-lib": "^1.17.1",
    "pino": "^9.1.0",
    "pino-http": "^10.1.0",
    "postgres": "^3.4.4",
    "tsx": "^4.7.0",
    "zod": "^3.25.28"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.2.17",
    "@types/cookie": "^0.6.0",
    "@types/express": "^4.17.21",
    "@types/heic-convert": "^2.1.1",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^7.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
